{
  "realm": "MyRealm",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "Gestionnaire",
        "description": "cree ordinateurs, reparations, ventes et peux consulte les statistiques"
      },
      {
        "name": "Administrateur",
        "description": "Tout ce que fait un gestionnaire + catalogue, types de reparations, utilisateurs",
        "composite": true,
        "composites": {
          "realm": [
            "Gestionnaire"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "efrei-api",
      "name": "RepairIT",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "efrei-api-secret-dev",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:5000/*"
      ],
      "webOrigins": [
        "http://localhost:5000"
      ],
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience-efrei-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "efrei-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin1",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
