{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5000" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route":             { "ClusterId": "auth",      "Match": { "Path": "/api/auth/{**catch-all}" } },
      "users-route":            { "ClusterId": "users",     "Match": { "Path": "/api/users/{**catch-all}" } },
      "ordinateurs-route":      { "ClusterId": "catalog",   "Match": { "Path": "/api/ordinateurs/{**catch-all}" } },
      "clients-route":          { "ClusterId": "customers", "Match": { "Path": "/api/clients/{**catch-all}" } },
      "reparations-route":      { "ClusterId": "repairs",   "Match": { "Path": "/api/reparations/{**catch-all}" } },
      "types-reparation-route": { "ClusterId": "repairs",   "Match": { "Path": "/api/types-reparation/{**catch-all}" } },
      "ventes-route":           { "ClusterId": "sales",     "Match": { "Path": "/api/ventes/{**catch-all}" } },
      "statistiques-route":     { "ClusterId": "sales",     "Match": { "Path": "/api/statistiques/{**catch-all}" } }
    },
    "Clusters": {
      "auth":      { "Destinations": { "default": { "Address": "http://localhost:5240/" } } },
      "users":     { "Destinations": { "default": { "Address": "http://localhost:5101/" } } },
      "catalog":   { "Destinations": { "default": { "Address": "http://localhost:5102/" } } },
      "customers": { "Destinations": { "default": { "Address": "http://localhost:5103/" } } },
      "repairs":   { "Destinations": { "default": { "Address": "http://localhost:5104/" } } },
      "sales":     { "Destinations": { "default": { "Address": "http://localhost:5105/" } } }
    }
  }
}